
name: Upload Existing QWEN Dataset

on:
  workflow_dispatch:
    inputs:
      repo_id:
        description: Hugging Face Dataset ID
        required: true
        type: string

permissions:
  actions: read
  contents: read

jobs:
  upload:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: Download Existing Artifact
        uses: actions/download-artifact@v4
        with:
          name: ultimate-qwen-validated-data
          run-id: "43019372413"
          github-token: ${{ secrets.GITHUB_TOKEN }}
          path: ./dataset

      - name: Install Hugging Face
        run: pip install -U "huggingface_hub[hf_xet]"

      - name: Upload Dataset
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          HF_DATASET_REPO: ${{ inputs.repo_id }}
        run: |
          python - <<'PY'
          import os
          from huggingface_hub import HfApi

          api = HfApi(token=os.environ["HF_TOKEN"])
          repo = os.environ["HF_DATASET_REPO"]

          api.create_repo(
              repo_id=repo,
              repo_type="dataset",
              private=True,
              exist_ok=True
          )

          api.upload_folder(
              folder_path="./dataset",
              repo_id=repo,
              repo_type="dataset",
              path_in_repo=".",
              commit_message="Upload existing ULTIMATE QWEN dataset"
          )

          print("UPLOAD SUCCESSFUL")
          PY
