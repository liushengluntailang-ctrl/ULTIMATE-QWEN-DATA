
name: Upload Existing Dataset to Hugging Face

on:
  workflow_dispatch:
    inputs:
      run_id:
        description: "成功した収集RunのID"
        required: true
      artifact_name:
        description: "既存Artifact名"
        required: true
        default: "ultimate-qwen-collected-data"
      repo_id:
        description: "Hugging Face Dataset ID (username/dataset-name)"
        required: true

permissions:
  actions: read
  contents: read

jobs:
  upload:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: Download Existing Artifact
        uses: actions/download-artifact@v4
        with:
          name: ${{ inputs.artifact_name }}
          path: ./existing-data
          run-id: ${{ inputs.run_id }}
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install Hugging Face Tools
        run: |
          python -m pip install --upgrade huggingface_hub hf_xet

      - name: Upload Existing Data
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          HF_DATASET_REPO: ${{ inputs.repo_id }}
        run: |
          python - <<'PY'
          import os
          from huggingface_hub import HfApi

          api = HfApi(token=os.environ["HF_TOKEN"])
          repo_id = os.environ["HF_DATASET_REPO"]

          api.create_repo(
              repo_id=repo_id,
              repo_type="dataset",
              private=True,
              exist_ok=True
          )

          api.upload_folder(
              folder_path="./existing-data",
              repo_id=repo_id,
              repo_type="dataset",
              path_in_repo=".",
              commit_message="Upload existing ULTIMATE QWEN dataset"
          )

          print("UPLOAD COMPLETED:", repo_id)
          PY
