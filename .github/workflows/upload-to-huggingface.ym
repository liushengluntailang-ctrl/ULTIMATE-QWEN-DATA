
name: Transfer Existing Artifact to Hugging Face

on:
  workflow_dispatch:

permissions:
  actions: read
  contents: read

jobs:
  transfer:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: Download Existing Artifact
        uses: actions/download-artifact@v4
        with:
          name: ultimate-qwen-validated-data
          run-id: "43019372413"
          github-token: ${{ secrets.GITHUB_TOKEN }}
          repository: liushengluntailang-ctrl/ULTIMATE-QWEN-DATA
          path: ./data

      - name: Install Hugging Face Hub
        run: pip install -U huggingface_hub hf_xet

      - name: Upload to Hugging Face
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
        run: |
          python - <<'PY'
          import os
          from huggingface_hub import HfApi

          api = HfApi(token=os.environ["HF_TOKEN"])
          repo = "yagyu77/ultimate-qwen-dataset"

          api.create_repo(
              repo_id=repo,
              repo_type="dataset",
              private=True,
              exist_ok=True
          )

          api.upload_folder(
              folder_path="./data",
              repo_id=repo,
              repo_type="dataset",
              path_in_repo=".",
              commit_message="Transfer existing validated QWEN artifact"
          )

          print("TRANSFER COMPLETE")
          PY
